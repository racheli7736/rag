{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build index",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build_index.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Streamlit app",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Evaluate",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
